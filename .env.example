# =========================================================================
# TournamentLive — Environment Variables
# Copy to .env.local (Vite) and fill in real values. Never commit .env.local.
# =========================================================================

# --- Supabase (client-side, safe to expose — protected by RLS) ----------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase (server-side / edge functions / seed scripts ONLY) --------
# NEVER prefix with VITE_ — must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PROJECT_REF=your-project-ref

# --- Auth ------------------------------------------------------------------
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# Google OAuth is configured in Supabase Dashboard -> Authentication -> Providers,
# this value is only needed if you render Google's button yourself.

# --- Payments ----------------------------------------------------------------
# Pick whichever gateway you use; both are wired for in the payments service.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (transactional, e.g. Resend/Postmark) ----------------------------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@tournamentlive.app

# --- App -------------------------------------------------------------------
VITE_APP_URL=http://localhost:5173
VITE_APP_BASE_DOMAIN=tournamentlive.app   # used to build organizer subdomains

# --- Deployment (Vercel) -----------------------------------------------------
# Configure the above as Vercel Project Environment Variables per environment
# (Production / Preview / Development). Do not set SUPABASE_SERVICE_ROLE_KEY
# on any environment that serves client-side code.
